# SentinelAI - Render Full-Stack Dockerfile
# Builds the React frontend and runs it alongside the FastAPI backend on the same origin.

# ---------- Stage 1: Build frontend ----------
FROM node:20-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---------- Stage 2: Backend + serve frontend ----------
FROM python:3.11-slim

WORKDIR /app

# System dependencies (curl for health checks, gcc for ML wheels)
RUN apt-get update && apt-get install -y \
    gcc g++ python3-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python deps
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./
COPY ai_engine/ ./ai_engine/
COPY dataset/ ./dataset/

# Copy built frontend into /app/frontend/dist (matched by app.py candidate list)
COPY --from=frontend-build /frontend/dist /app/frontend/dist

# Create runtime directories
RUN mkdir -p /app/models /app/output /app/logs

# Expose backend port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI with uvicorn (no reload in production)
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
